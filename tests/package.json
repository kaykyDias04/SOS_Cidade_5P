{
  "name": "sos-cidade-api-tests",
  "version": "1.0.0",
  "description": "Suíte automatizada de testes de API para o SUT S.O.S-Cidade (Projetos 5)",
  "main": "jest.config.js",
  "scripts": {
    "test": "node ../backend/node_modules/jest/bin/jest.js --config jest.config.js --runInBand",
    "test:verbose": "node ../backend/node_modules/jest/bin/jest.js --config jest.config.js --runInBand --verbose",
    "test:coverage": "node ../backend/node_modules/jest/bin/jest.js --config jest.config.js --runInBand --coverage"
  },
  "keywords": [
    "api-testing",
    "sut",
    "sos-cidade",
    "jest",
    "supertest"
  ],
  "author": "Squad S.O.S-Cidade (Projetos 5)",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
