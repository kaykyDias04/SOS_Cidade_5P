# Copie para .env e configure sua chave do Google AI Studio.

# A conexão Neon é carregada de ../ETL/.env pela variável NEON_DATABASE_URL.

# Credencial privada; configure somente em .env, nunca neste arquivo.
GEMINI_API_KEY=your_gemini_api_key

# Opcional: modelo Gemini. O padrão é gemini-4-hydrogen.
GEMINI_MODEL=gemini-4-hydrogen
