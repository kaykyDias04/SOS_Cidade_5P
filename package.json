{
  "name": "sos-cidade",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm --prefix tests test",
    "test:coverage": "node scripts/test-management/run.cjs api",
    "test:unit": "npm run test:unit:frontend && npm run test:unit:backend && npm run test:unit:mobile",
    "test:unit:frontend": "node scripts/test-management/run.cjs frontend",
    "test:unit:backend": "node scripts/test-management/run.cjs backend",
    "test:unit:mobile": "npm --prefix mobile run test:ci",
    "test:api": "node scripts/test-management/run.cjs api",
    "test:e2e": "node scripts/test-management/run.cjs e2e",
    "test:e2e:smoke": "node scripts/test-management/run.cjs smoke",
    "test:e2e:quarentena": "npm run test:quarantine -- e2e",
    "test:verbose": "npm --prefix tests run test:verbose",
    "test:management:validate": "node scripts/test-management/review.cjs --validate",
    "test:management:selftest": "node --test scripts/test-management/selftest.cjs",
    "test:review": "node scripts/test-management/review.cjs",
    "test:diagnostic": "node scripts/test-management/run.cjs",
    "test:quarantine": "node scripts/test-management/quarantine.cjs"
  }
}
